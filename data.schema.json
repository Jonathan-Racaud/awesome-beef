{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/awesome-beef/data.schema.json",
  "title": "Awesome Beef curated list",
  "description": "Single source of truth for the Awesome Beef curated list. Flat list with parent references, consumed by the README generator and the static website.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "categories", "entries"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "banner": { "type": "string" },
        "badge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "url"],
          "properties": {
            "text": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "inspiration": { "type": "string", "format": "uri" }
      }
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "parent"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "parent": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/slug" }
          ]
        },
        "description": { "type": "string" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "category": { "$ref": "#/$defs/slug" },
        "tags": { "$ref": "#/$defs/tags" },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "deprecated": { "type": "boolean" }
      }
    }
  }
}
